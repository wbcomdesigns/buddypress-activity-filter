{
    "name": "wbcomdesigns/buddypress-activity-filter",
    "description": "BuddyPress Activity Filter.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "gin0115/buddypress-stubs": "^12.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
